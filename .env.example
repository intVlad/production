# Copy to .env and fill in. Never commit the filled-in .env.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mes
POSTGRES_PASSWORD=            # generate: openssl rand -base64 24
POSTGRES_DB=production_mvp

# --- Signing key for login tokens -------------------------------------------
# Required. The backend refuses to start against a persistent database without it.
# Generate: openssl rand -base64 48
# Changing it later signs everyone out; keep it stable and backed up.
JWT_SECRET=

# --- First administrator ----------------------------------------------------
# A fresh database has no accounts, and an account is needed to create accounts.
# Set this for the first start only, sign in with it, create the real accounts
# through the UI, change this PIN, then remove the variable.
APP_BOOTSTRAP_ADMIN_PIN=

# --- Browser origins allowed to call the API --------------------------------
# Only needed when the UI is served from a different origin than the API.
# Comma-separated, e.g. https://mes.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:8000

# --- Demo data --------------------------------------------------------------
# Seeds example sections, workers and a product model, with PINs published in the
# repository. For a demo or staging environment only - never for real production.
# APP_SEED_DEMO_DATA=true
